---
import type { Article } from "../lib/articles";
import type { MarkdownHeading } from "astro";
import { formatDate } from "../lib/articles";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  article: Article;
  headings: MarkdownHeading[];
}

const { article, headings } = Astro.props;
const updated =
  article.data.updated.valueOf() !== article.data.date.valueOf()
    ? formatDate(article.data.updated)
    : null;
const tocHeadings = headings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= 4,
);
---

<BaseLayout
  title={article.data.title}
  description={article.data.summary}
  type="article"
>
  <div class="article-reader">
    <article class="article-shell">
      <header class="article-header">
        <div class="article-toolbar">
          <a class="back-link" href="/articles/">← 全部文章</a>
          <label class="reading-theme-picker">
            <span>阅读主题</span>
            <select aria-label="选择文章阅读主题">
              <option value="github">GitHub</option>
              <option value="newsprint">Newsprint</option>
              <option value="academic">Academic</option>
              <option value="minimal">Minimal</option>
              <option value="sepia">Sepia</option>
              <option value="night">Night</option>
            </select>
          </label>
        </div>
        <h1>{article.data.title}</h1>
        <div class="article-meta">
          <time datetime={article.data.date.toISOString()}>
            发布于 {formatDate(article.data.date)}
          </time>
          {updated && <span>更新于 {updated}</span>}
        </div>
        <ul class="tag-list" aria-label="文章标签">
          {article.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </header>

      {
        tocHeadings.length > 0 && (
          <details class="mobile-toc">
            <summary>目录</summary>
            <nav aria-label="文章目录">
              <ol>
                {tocHeadings.map((heading) => (
                  <li class={`toc-depth-${heading.depth}`}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </details>
        )
      }

      <div class="prose">
        <slot />
      </div>
    </article>

    {
      tocHeadings.length > 0 && (
        <aside class="article-toc">
          <p>目录</p>
          <nav aria-label="文章目录">
            <ol>
              {tocHeadings.map((heading) => (
                <li class={`toc-depth-${heading.depth}`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )
    }
  </div>

  <dialog class="image-viewer" aria-label="图片查看器">
    <button type="button" aria-label="关闭图片查看器">关闭</button>
    <img alt="" />
  </dialog>

  <script>
    const addCopyButtons = () => {
      document.querySelectorAll<HTMLElement>(".prose pre").forEach((block) => {
        if (block.classList.contains("mermaid") || block.querySelector(".copy-code")) {
          return;
        }

        const button = document.createElement("button");
        button.type = "button";
        button.className = "copy-code";
        button.textContent = "复制";
        button.setAttribute("aria-label", "复制代码");
        button.addEventListener("click", async () => {
          const code = block.querySelector("code")?.textContent || "";
          await navigator.clipboard.writeText(code);
          button.textContent = "已复制";
          window.setTimeout(() => {
            button.textContent = "复制";
          }, 1500);
        });
        block.append(button);
      });
    };

    const setupReadingTheme = () => {
      const select =
        document.querySelector<HTMLSelectElement>(".reading-theme-picker select");
      if (!select) return;

      const allowed = [
        "github",
        "newsprint",
        "academic",
        "minimal",
        "sepia",
        "night",
      ];
      const current = document.documentElement.dataset.readingTheme || "github";
      select.value = allowed.includes(current) ? current : "github";

      select.addEventListener("change", () => {
        const theme = allowed.includes(select.value) ? select.value : "github";
        if (theme === "github") {
          delete document.documentElement.dataset.readingTheme;
          localStorage.removeItem("reading-theme");
        } else {
          document.documentElement.dataset.readingTheme = theme;
          localStorage.setItem("reading-theme", theme);
        }
      });
    };

    const setupTableOfContents = () => {
      const links = Array.from(
        document.querySelectorAll<HTMLAnchorElement>(
          ".article-toc a, .mobile-toc a",
        ),
      );
      if (links.length === 0) return;

      const headings = links
        .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
        .filter((heading): heading is HTMLElement => Boolean(heading));

      const setCurrent = (id: string) => {
        links.forEach((link) => {
          if (decodeURIComponent(link.hash.slice(1)) === id) {
            link.setAttribute("aria-current", "location");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      };

      const updateCurrent = () => {
        const threshold = 112;
        let current = headings[0];
        for (const heading of headings) {
          if (heading.getBoundingClientRect().top <= threshold) current = heading;
          else break;
        }
        if (current) setCurrent(current.id);
      };

      links.forEach((link) => {
        link.addEventListener("click", () => {
          setCurrent(decodeURIComponent(link.hash.slice(1)));
          link.closest<HTMLDetailsElement>(".mobile-toc")?.removeAttribute("open");
        });
      });

      updateCurrent();
      document.addEventListener("scroll", updateCurrent, { passive: true });
    };

    const setupImageViewer = () => {
      const dialog = document.querySelector<HTMLDialogElement>(".image-viewer");
      const viewerImage = dialog?.querySelector<HTMLImageElement>("img");
      const closeButton = dialog?.querySelector<HTMLButtonElement>("button");

      document.querySelectorAll<HTMLImageElement>(".prose img").forEach((image) => {
        image.tabIndex = 0;
        image.setAttribute("role", "button");
        image.setAttribute("aria-label", `${image.alt || "文章图片"}，点击查看大图`);

        const open = () => {
          if (!dialog || !viewerImage) return;
          viewerImage.src = image.currentSrc || image.src;
          viewerImage.alt = image.alt;
          dialog.showModal();
        };

        image.addEventListener("click", open);
        image.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            open();
          }
        });
      });

      closeButton?.addEventListener("click", () => dialog?.close());
      dialog?.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
    };

    const renderDiagrams = async () => {
      const diagrams = document.querySelectorAll<HTMLElement>(".mermaid");
      if (diagrams.length === 0) return;

      const { default: mermaid } = await import("mermaid");
      mermaid.initialize({
        startOnLoad: false,
        theme: "neutral",
        securityLevel: "strict",
        fontFamily: "inherit",
      });
      await mermaid.run({ nodes: diagrams });
    };

    addCopyButtons();
    setupReadingTheme();
    setupTableOfContents();
    setupImageViewer();
    renderDiagrams();
  </script>
</BaseLayout>
