---
import ArticleCard from "../components/ArticleCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedArticles } from "../lib/articles";

const articles = await getPublishedArticles();
const recentArticles = articles.slice(0, 6);
---

<BaseLayout>
  <section class="page-shell home-page">
    <header class="page-heading">
      <p class="eyebrow">QuartzYan’s Notes</p>
      <h1>最近文章</h1>
      <p>关于机器人、嵌入式系统与工程实践的记录。</p>
    </header>

    <div class="article-list">
      {recentArticles.map((article) => <ArticleCard article={article} />)}
    </div>

    {
      articles.length > recentArticles.length && (
        <a class="text-link" href="/articles/">查看全部文章 →</a>
      )
    }
  </section>
</BaseLayout>
